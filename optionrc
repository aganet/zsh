# ============================================================================
# Shell options & history — sourced from .zshrc
# ============================================================================

# -- History -----------------------------------------------------------------
HISTFILE="$XDG_DATA_HOME/zsh/.zhistory"
SAVEHIST=1000000
HISTSIZE=1000000
[[ -d "${HISTFILE:h}" ]] || mkdir -p "${HISTFILE:h}"
setopt share_history          # share history across all open shells
setopt hist_expire_dups_first # prune duplicates first when trimming history
setopt hist_ignore_dups       # don't store consecutive duplicates
setopt hist_ignore_space      # don't store commands starting with a space
setopt hist_verify            # show command before running on `!` expansion

# -- Shell options -----------------------------------------------------------
setopt correct                # autocorrect command typos
setopt autocd                 # cd by typing directory name
setopt extendedglob           # extended globbing patterns
setopt nocaseglob             # case-insensitive globbing
setopt numericglobsort        # sort file1 file2 file10 correctly
setopt rcexpandparam          # array expansion with params
setopt nocheckjobs            # don't warn about running jobs on exit
setopt nobeep                 # no terminal beep

# -- Completion --------------------------------------------------------------
zstyle ':completion:*' rehash true   # auto-pick up new executables in PATH

# -- GPG ---------------------------------------------------------------------
export GPG_TTY=$(tty)
