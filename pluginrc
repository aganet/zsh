# ============================================================================
# Oh My Zsh & plugins — sourced from .zshrc
# ============================================================================
export ZSH="${ZSH:-$HOME/.oh-my-zsh}"
ZSH_THEME="powerlevel10k/powerlevel10k"

# Skip OMZ's bracketed-paste-magic / url-quote-magic widgets. They re-parse
# the entire pasted buffer on each character, which combined with
# fast-syntax-highlighting and zsh-autosuggestions causes multi-second pauses
# when pasting multi-line commands (e.g. long `terraform -target=...` chains).
# Trade-off: URL special chars (`?` `&` `*`) won't auto-escape on paste —
# quote URLs manually if needed.
DISABLE_MAGIC_FUNCTIONS=true

# Base plugins (all platforms)
# NOTE: fzf-tab must come before zsh-autosuggestions and fast-syntax-highlighting
plugins=(
  git
  fzf
  fzf-tab
  dotenv
  vscode
  cp
  colorize
  encode64
  zsh-autosuggestions
  fast-syntax-highlighting
)

# DevOps tools — only load if the binary is on $PATH
command -v docker    &>/dev/null && plugins+=(docker docker-compose)
command -v kubectl   &>/dev/null && plugins+=(kubectl)
command -v helm      &>/dev/null && plugins+=(helm)
command -v terraform &>/dev/null && plugins+=(terraform)
command -v aws       &>/dev/null && plugins+=(aws)
command -v az        &>/dev/null && plugins+=(azure)

# Ruby toolchain
command -v rbenv &>/dev/null && plugins+=(bundler rake rbenv ruby)

# macOS-specific
[[ "$CURRENT_OS" == "macos" ]] && plugins+=(macos brew)

source "$ZSH/oh-my-zsh.sh"
