# Host/identity-specific config — copy to local.zsh and edit.
#
#   cp local.zsh.example local.zsh
#
# local.zsh is gitignored, so anything sensitive (internal hostnames, service
# principal IDs, work SSH usernames, work-specific cert paths) stays off
# GitHub. The repo's .zshrc sources local.zsh at the very end, so anything
# here can override defaults.
#
# Skipping this step is safe: the shared config already handles the universal
# pieces (Krew/Go/kubescape PATH, switcher, Nix, Tilix, NVM lazy-load, WezTerm
# kube-context hook, ~/.bash_aliases sourcing, Up/Down prefix-history search).
# Only fill this file in if you need the kinds of things below.

# -- Personal SSH shortcuts (example) ---------------------------------------
# alias sshbox1='ssh user@10.0.0.10'
# alias sshbox2='ssh user@10.0.0.11'



# -- Detailed kubectl events (overrides the repo's `kev`) -------------------
# alias events='kubectl get events --sort-by=.lastTimestamp -o custom-columns=LASTSEEN:.lastTimestamp,FIRSTSEEN:.firstTimestamp,COUNT:.count,TYPE:.type,REASON:.reason,OBJECT:.involvedObject.name,MESSAGE:.message'
